{
  "manifest_version": 3,
  "name": "HF Bulk Explorer",
  "version": "1.0.0",
  "description": "Envia links publicos visiveis para o modulo Baixar em Massa do HF New Control Hub.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://api.hfnew.com.br/*",
    "https://www.instagram.com/*",
    "https://www.youtube.com/*",
    "https://www.tiktok.com/*",
    "https://www.facebook.com/*",
    "https://www.pinterest.com/*",
    "https://www.kwai.com/*"
  ],
  "action": {
    "default_title": "HF Bulk Explorer",
    "default_popup": "popup.html"
  }
}
