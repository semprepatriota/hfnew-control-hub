{
  "manifest_version": 3,
  "name": "HF Bulk Explorer",
  "version": "1.2.1",
  "description": "Coleta e organiza links, miniaturas e metricas publicas visiveis de redes suportadas para o modulo Baixar em Massa do HF.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://www.tiktok.com/*",
    "https://www.facebook.com/*",
    "https://www.pinterest.com/*",
    "https://www.kwai.com/*"
  ],
  "action": {
    "default_title": "HF Bulk Explorer",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://app.hfnew.com.br/*", "https://www.instagram.com/*"],
      "js": ["content-status.js"],
      "run_at": "document_idle"
    }
  ]
}
