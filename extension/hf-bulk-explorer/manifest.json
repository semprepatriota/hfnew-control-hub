{
  "manifest_version": 3,
  "name": "HF Bulk Explorer",
  "version": "1.3.1",
  "description": "Coleta links, miniaturas e métricas públicas visíveis para o módulo Baixar em Massa do HF New Control Hub.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://app.hfnew.com.br/*",
    "https://www.instagram.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "HF Bulk Explorer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://app.hfnew.com.br/*", "https://www.instagram.com/*"],
      "js": ["content-status.js"],
      "run_at": "document_idle"
    }
  ]
}
